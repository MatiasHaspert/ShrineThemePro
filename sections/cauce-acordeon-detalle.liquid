{% comment %}
  CAUCE — acordeon de detalle.

  Fuente de contenido, en orden:
    1. metafield cauce.beneficios del producto (lista de metaobjetos con los
       campos titulo y texto). Es la via reusable: cargas el producto y la
       seccion se llena sola.
    2. bloques propios de la seccion, para paginas que no son de producto.

  Si no hay ninguna de las dos, la seccion no renderiza nada.

  Sin JavaScript: <details> y <summary> nativos ya exponen el estado expandido a
  lectores de pantalla y responden a teclado. Agregar un acordeon propio seria
  gastar bytes en reimplementar algo que el navegador hace mejor.
{% endcomment %}

{%- liquid
  assign cauce_prod = product
  if section.settings.producto != blank
    assign cauce_prod = section.settings.producto
  endif

  assign cauce_lista = cauce_prod.metafields.cauce.beneficios.value
  assign cauce_desde_mf = false
  if cauce_lista != blank and cauce_lista.size > 0
    assign cauce_desde_mf = true
  endif

  assign cauce_hay = cauce_desde_mf
  unless cauce_hay
    for block in section.blocks
      if block.settings.titulo != blank
        assign cauce_hay = true
        break
      endif
    endfor
  endunless
-%}

{%- if cauce_hay -%}
  <div class="cauce-detalle color-{{ section.settings.color_scheme }} gradient">
    <div
      class="page-width cauce-detalle__inner"
      style="--padding-top: {{ section.settings.padding_top }}px; --padding-bottom: {{ section.settings.padding_bottom }}px;"
    >
      {%- if section.settings.volanta != blank -%}
        <p class="cauce-eyebrow">{{ section.settings.volanta }}</p>
      {%- endif -%}

      {%- if section.settings.titulo != blank -%}
        <h2 class="cauce-detalle__titulo {{ section.settings.heading_size }}">{{ section.settings.titulo }}</h2>
      {%- endif -%}

      <div class="cauce-detalle__lista">
        {%- if cauce_desde_mf -%}
          {%- for cauce_item in cauce_lista -%}
            {%- if cauce_item.titulo != blank -%}
              <details class="cauce-detalle__item">
                <summary class="cauce-detalle__summary">
                  <span class="cauce-detalle__item-titulo">{{ cauce_item.titulo }}</span>
                  {% render 'icon-caret' %}
                </summary>
                <div class="cauce-detalle__contenido rte">
                  {{ cauce_item.texto | metafield_tag }}
                </div>
              </details>
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          {%- for block in section.blocks -%}
            {%- if block.settings.titulo != blank -%}
              <details class="cauce-detalle__item" {{ block.shopify_attributes }}>
                <summary class="cauce-detalle__summary">
                  <span class="cauce-detalle__item-titulo">{{ block.settings.titulo }}</span>
                  {% render 'icon-caret' %}
                </summary>
                <div class="cauce-detalle__contenido rte">
                  {{ block.settings.texto }}
                </div>
              </details>
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "CAUCE · Detalle",
  "tag": "section",
  "class": "section cauce-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Si el producto tiene cargado el metafield cauce.beneficios, la seccion lo usa y ignora los bloques de abajo. Los bloques son para paginas que no son de producto."
    },
    { "type": "text", "id": "volanta", "label": "Volanta" },
    { "type": "inline_richtext", "id": "titulo", "label": "Titulo", "default": "En detalle" },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Tamano del titulo",
      "options": [
        { "value": "h2", "label": "Chico" },
        { "value": "h1", "label": "Mediano" },
        { "value": "h0", "label": "Grande" }
      ],
      "default": "h1"
    },
    { "type": "product", "id": "producto", "label": "Producto", "info": "Solo hace falta fuera de una pagina de producto." },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Esquema de color",
      "options": [
        { "value": "background-1", "label": "Sedimento" },
        { "value": "background-2", "label": "Sedimento 2" },
        { "value": "inverse", "label": "Tinta" }
      ],
      "default": "background-1"
    },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 8, "unit": "px", "label": "Arriba", "default": 72 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 8, "unit": "px", "label": "Abajo", "default": 72 }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        { "type": "text", "id": "titulo", "label": "Titulo" },
        { "type": "richtext", "id": "texto", "label": "Texto" }
      ]
    }
  ],
  "presets": [
    {
      "name": "CAUCE · Detalle",
      "blocks": [{ "type": "item" }, { "type": "item" }, { "type": "item" }]
    }
  ]
}
{% endschema %}
