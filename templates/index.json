        },
        "texto": {
          "type": "text",
          "settings": {
            "text": "<p>Cada fórmula lleva la lista completa de lo que contiene y en qué cantidad. Sin mezclas propietarias, sin letra chica y sin promesas que no podamos sostener.</p>"
          }
        },
