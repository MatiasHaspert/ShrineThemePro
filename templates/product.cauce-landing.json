    "cauce_faq_nNHY4y": {
      "type": "cauce-faq",
      "blocks": {
        "pregunta_N3EzqD": {
          "type": "pregunta",
          "settings": {
            "pregunta": "¿Cómo tomo Cauce?",
            "respuesta": "<p>Una cápsula al día con un vaso de agua, de preferencia con una comida. Suave para el estómago.</p>"
          }
        },
        "pregunta_3MTnDn": {
          "type": "pregunta",
          "settings": {
            "pregunta": "¿Cuándo veré resultados?",
            "respuesta": "<p>La mayoría nota un cambio en 3 a 5 semanas, con beneficio completo en 2 a 3 meses.</p>"
          }
        },
        "pregunta_GEFRqQ": {
          "type": "pregunta",
          "settings": {
            "pregunta": "Ya probé el ácido alfa lipoico y no hizo nada. ¿Por qué este es diferente?",
            "respuesta": "<p>La mayoría del ALA es una mezcla racémica 50/50 — la mitad es el isómero S inactivo. Cauce es 100% forma R pura a la dosis clínica completa de 600mg.</p>"
          }
        },
        "pregunta_wbfExg": {
          "type": "pregunta",
          "settings": {
            "pregunta": "¿En qué se diferencia de la berberina?",
            "respuesta": "<p>La berberina actúa en el \"grifo\" del hígado. El R-ALA ayuda a llevar el azúcar al músculo — el \"desagüe\". Mecanismo diferente y más suave para el estómago.</p>"
          }
        },
        "pregunta_pkHfAT": {
          "type": "pregunta",
          "settings": {
            "pregunta": "¿Cuál es la descripción del producto?",
            "respuesta": "<p>Noverly Ácido Alfa Lipoico R entrega <strong>600mg de ácido alfa lipoico puro en forma R-(+)</strong>— el isómero biológicamente activo que tu cuerpo realmente usa — en una cápsula pequeña hecha con aceite de coco para mejor absorción. El R-ALA ayuda a sacar el azúcar de la sangre y llevarlo a los músculos, apoyando un azúcar saludable dentro del rango normal, energía estable todo el día y protección antioxidante. Sin transgénicos, sin gluten, probado por terceros, hecho en Argentina. 30 cápsulas por bolsa (suministro para 30 días).<br/><br/></p>"
          }
        }
      },
