{% comment %}
  CAUCE — /cart. Reusa LOS MISMOS snippets que el drawer.

  La razon es una sola: /cart no puede ser un segundo diseno que se desincroniza
  del drawer al primer cambio. La linea de producto, el reaseguro, la barra de
  envio, el empujon y la leyenda son exactamente los mismos archivos; lo unico
  que cambia es el contexto ('cart' en vez de 'drawer') y la clase contenedora,
  que activa el modificador de layout del bloque 17 de cauce-brand.css.

  Sale la tabla de Shrine. El <tr role="row"> no aportaba nada —el carrito no es
  una tabla de datos, es una lista de items editables— y era lo unico que impedia
  compartir la linea con el drawer.

  HOOKS que cablea CartItems (verificados contra assets/main.js de este repo):
    <cart-items> ............... el custom element; se le agrega/saca .is-empty.
    #main-cart-items[data-id] .. getSectionsToRender lee data-id para pedir la
                                 seccion renderizada.
    .js-contents ............... region que se reemplaza por innerHTML. TODO lo
                                 que tenga que recalcularse al cambiar cantidades
                                 vive adentro.
    #cart-live-region-text / #shopping-cart-line-item-status
    <form id="cart"> ........... el boton de pago de main-cart-footer apunta acá.
    .cart__contents / .cart__warnings ... base.css los alterna con .is-empty.
{% endcomment %}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<cart-items class="page-width cauce-carrito cauce-carrito--pagina gradient color-{{ section.settings.color_scheme }}{% if cart == empty %} is-empty{% else %} section-{{ section.id }}-padding{% endif %}">
  <div class="cauce-carrito__columna">
    <div class="title-wrapper-with-link cauce-carrito__cabecera">
      <h1 class="cauce-carrito__titulo">{{ 'sections.cart.title' | t }}</h1>
      <a
        href="{% if settings.continue_shopping_url == blank %}{{ routes.all_products_collection_url }}{% else %}{{ settings.continue_shopping_url }}{% endif %}"
        class="cauce-carrito__volver"
      >
        {{- 'general.continue_shopping' | t -}}
      </a>
    </div>

    <div class="cart__warnings">
      {% render 'cauce-carrito-vacio' %}
    </div>

    <form action="{{ routes.cart_url }}" class="cart__contents critical-hidden" method="post" id="cart">
      <div class="cart__items" id="main-cart-items" data-id="{{ section.id }}">
        <div class="js-contents">
          {%- if cart != empty -%}
            <div class="cauce-carrito__bloque">
              {% render 'cauce-carrito-reaseguro',
                arrepentimiento: section.settings.mostrar_arrepentimiento,
                iva: section.settings.mostrar_iva,
                envio: section.settings.mostrar_envio
              %}
            </div>

            <div class="cauce-carrito__bloque">
              {% render 'cauce-carrito-envio' %}
            </div>

            <ul class="cauce-carrito__items" role="list">
              {%- for item in cart.items -%}
                {% render 'cauce-carrito-linea',
                  item: item,
                  contexto: 'cart',
                  formato: section.settings.mostrar_formato,
                  por_dia: section.settings.mostrar_precio_dia
                %}
              {%- endfor -%}
            </ul>

            <div class="cauce-carrito__bloque">
              {% render 'cauce-carrito-nudge' %}
            </div>

            <div class="cauce-carrito__legal">
              {% render 'cauce-disclaimer', compacto: true %}
            </div>
          {%- endif -%}
        </div>
      </div>

      <p class="visually-hidden" id="cart-live-region-text" aria-live="polite" role="status"></p>
      <p
        class="visually-hidden"
        id="shopping-cart-line-item-status"
        aria-live="polite"
        aria-hidden="true"
        role="status"
      >
        {{ 'accessibility.loading' | t }}
      </p>
    </form>
  </div>
</cart-items>

{% schema %}
{
  "name": "t:sections.main-cart-items.name",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "background-1"
    },
    {
      "type": "header",
      "content": "Reaseguro"
    },
    {
      "type": "checkbox",
      "id": "mostrar_arrepentimiento",
      "label": "Días de arrepentimiento",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "mostrar_iva",
      "label": "Precio final con IVA",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "mostrar_envio",
      "label": "Envío a todo el país",
      "default": false,
      "info": "Apagado por defecto: depende de las zonas de envío que tengas configuradas en Shopify."
    },
    {
      "type": "header",
      "content": "Línea de producto"
    },
    {
      "type": "checkbox",
      "id": "mostrar_formato",
      "label": "Mostrar el formato",
      "default": true,
      "info": "Metacampo cauce.formato del producto. Sin el metacampo no se muestra nada."
    },
    {
      "type": "checkbox",
      "id": "mostrar_precio_dia",
      "label": "Mostrar el precio por día de uso",
      "default": true,
      "info": "Se calcula con cauce.unidades_envase y cauce.dosis_diaria."
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
